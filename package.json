{
  "name": "medify",
  "version": "1.0.0",
  "description": "MediFy atomic migration \u2014 plain HTML + vanilla JS modules, being migrated from Legacy pages/ per CHANGE.md.",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js tests/features/",
    "test:reference": "backstop reference",
    "test:visual": "backstop test",
    "test:visual:approve": "backstop approve",
    "serve": "python3 -m http.server 8000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"js/**/*.js\" \"tests/**/*.js\" \"components/**/*.js\"",
    "format:check": "prettier --check \"js/**/*.js\" \"tests/**/*.js\" \"components/**/*.js\"",
    "check": "npm run lint && npm run format:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6"
  }
}
